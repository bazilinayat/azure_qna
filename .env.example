# Copy to .env and fill in. Every value here is optional except OPENAI_API_KEY.

# --------------------------------------------------
# LLM
# --------------------------------------------------
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5.4-mini

# Cost per answer can only be reported for models whose price is known.
# gpt-5.4-mini's rate is not built in -- look it up at
# https://openai.com/api/pricing and set both, in USD per 1M tokens.
# LLM_PRICE_INPUT_PER_1M=0.25
# LLM_PRICE_OUTPUT_PER_1M=2.00

# --------------------------------------------------
# Monitoring
# --------------------------------------------------
# DELETE, not WAL. WAL needs an mmap'd -shm file, which does not work on Docker
# Desktop's Windows bind mounts: Grafana then cannot read the database at all,
# and mixed journal modes across processes can lose committed rows. WAL is safe
# on a Linux host and gives better read/write concurrency.
MONITORING_JOURNAL_MODE=DELETE
MONITORING_ENABLED=true

# grounded_mentor (default), concise, or strict_extractive.
LLM_PROMPT=grounded_mentor
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_CONTEXT_CHUNKS=5

# --------------------------------------------------
# Storage
# --------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true

# DATABASE_PATH and QDRANT_COLLECTION are deliberately NOT set here.
# They derive from CHUNK_MAX_TOKENS (data/azurementor-c480.db,
# azure_docs_c480), which is what stops two chunk-size experiments from
# overwriting each other. Setting either one pins every chunk size to the same
# store and makes retrieval comparisons meaningless. The pipeline warns if you
# do. Only set them if you genuinely want a single fixed location.
# DATABASE_PATH=data/azurementor.db
# QDRANT_COLLECTION=azure_docs

# --------------------------------------------------
# Ingestion scope
# --------------------------------------------------
# false = curated core services, 15 folders / ~3,900 articles / ~27k chunks.
#         Roughly 55 minutes to embed on an 8-core CPU.
# true  = all 145 folders / ~13,500 articles / ~95k chunks / several hours,
#         and noisier retrieval.
INGEST_ALL_CATEGORIES=false

# Override the curated list entirely (comma-separated service folder names,
# matching directory names under azure-docs/articles).
# INGEST_CATEGORIES=storage,app-service,azure-functions

SKIP_INCLUDE_FILES=true
MIN_DOC_TOKENS=80

# --------------------------------------------------
# Chunking  --  the one knob for retrieval experiments
# --------------------------------------------------
# Measured with the embedding model's own tokenizer, not tiktoken.
# bge-small-en-v1.5 truncates at 512, so this must stay below it.
#
# Prefer the CLI flag over setting this here, since it works per-run:
#     uv run python -m app.pipeline --fresh --chunk-size 256
CHUNK_MAX_TOKENS=480

# Both derive from CHUNK_MAX_TOKENS (1/8 and 1/16 of it) unless set explicitly.
# Leave them alone unless you are deliberately testing the overlap ratio --
# a fixed overlap does not scale, and at small chunk sizes it silently becomes
# a huge fraction of every chunk.
# CHUNK_OVERLAP_TOKENS=60
# CHUNK_MIN_TOKENS=30

# --------------------------------------------------
# Embedding
# --------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# torch or fastembed. torch measured ~4x faster (8.3 vs 2.2 chunks/s) because
# fastembed ships the int8-quantized ONNX build, which is slower than fp32 on
# this CPU. Changing this re-embeds the corpus automatically — the two backends
# do not share a vector space.
EMBEDDING_BACKEND=torch

# Throughput plateaus around 8 threads for this model.
EMBEDDING_THREADS=8

EMBEDDING_BATCH_SIZE=512
EMBEDDING_MODEL_BATCH_SIZE=32

# bge applies an instruction prefix to queries only. Empty string disables it.
# EMBEDDING_QUERY_PREFIX=

# --------------------------------------------------
# Reranking
# --------------------------------------------------
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
